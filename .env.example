# ==============================================================================
# MistriBhaiya Environment Configuration (.env)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Core & Security
SECRET_KEY=mistribhaiya-super-secret-jwt-key-2026-prod
DEV_MODE=0                                              # Set to 1 only during local development (returns OTP in API)
ADMIN_PHONES=9837101839,9837101838                      # Comma-separated admin phone numbers
CORS_ORIGINS=https://mistribhaiya-f5a94.web.app,https://mistribhaiya-f5a94.firebaseapp.com

# Database
DB_PATH=kaamsetu.db                                     # Path to SQLite database (e.g. /data/mistribaiya.db on Render with persistent disk)

# Operational & Geography Settings
DEFAULT_RADIUS_KM=6
MAX_RADIUS_KM=100
FREE_DEFAULT_HOURS=12
TOKEN_DAYS=60
REQUIRE_START_OTP=1                                     # Require worker to enter customer's 4-digit OTP to start work

# Rapido-style Instant Dispatch
INSTANT_WAVE_SECONDS=30                                 # Duration each wave of worker offers stays open
INSTANT_WAVE_SIZE=1                                     # Workers contacted per wave (nearest first)
INSTANT_MAX_WAVES=3                                     # Maximum waves before declaring no worker found

# SMS Provider (console | msg91)
SMS_PROVIDER=console
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# Calling Provider (direct | exotel)
CALL_PROVIDER=direct
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_EXOPHONE=

# WebRTC Audio Calling (In-App voice)
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USER=
TURN_PASS=

# AI Assistant / NLP (Gemini / Anthropic)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=gemini-2.5-flash

# Payments & Escrow (Razorpay / Cashfree + UPI)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_FEE_PCT=5                                      # Platform fee percentage deducted on completion
